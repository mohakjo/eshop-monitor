# Toutes ces variables sont optionnelles : sans elles, les valeurs par défaut
# définies dans nuxt.config.ts (runtimeConfig) s'appliquent.

# GlitchTip — DSN affiché par l'interface après création du projet
NUXT_PUBLIC_GLITCHTIP_DSN=CHANGE_ME@localhost:8000/1
NUXT_PUBLIC_GLITCHTIP_TRACES_SAMPLE_RATE=1

# Umami — ID du site créé depuis l'interface web (:3000)
NUXT_PUBLIC_UMAMI_SCRIPT_URL=http://localhost:3000/script.js
NUXT_PUBLIC_UMAMI_WEBSITE_ID=f3276f17-e9d7-4235-93a2-6609febb6f24

# API produits (serveur et navigateur)
NUXT_DUMMY_JSON_BASE_URL=https://dummyjson.com
NUXT_PUBLIC_DUMMY_JSON_BASE_URL=https://dummyjson.com
