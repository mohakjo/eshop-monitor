# Copier en .env puis renseigner les valeurs de VOS instances locales.
# Ces identifiants sont générés à la création du site Umami et du projet
# GlitchTip : ils sont différents sur chaque installation.
#
# Le service `nuxt` du docker-compose lit ce fichier au démarrage.
# Sans .env, les valeurs par défaut de nuxt.config.ts s'appliquent.

# --- Umami (http://localhost:3000, compte par défaut admin / umami) ---
# Websites > Add website, puis récupérer l'ID dans les détails du site.
NUXT_PUBLIC_UMAMI_WEBSITE_ID=00000000-0000-0000-0000-000000000000
NUXT_PUBLIC_UMAMI_SCRIPT_URL=http://localhost:3000/script.js

# --- GlitchTip (http://localhost:8000) ---
# Créer un compte, une organisation, une équipe puis un projet.
# Le DSN complet est affiché dans Settings > Client Keys (DSN).
# Attention : le schéma http:// fait partie du DSN.
NUXT_PUBLIC_GLITCHTIP_DSN=http://CHANGE_ME@localhost:8000/1
NUXT_PUBLIC_GLITCHTIP_ENVIRONMENT=production
NUXT_PUBLIC_GLITCHTIP_TRACES_SAMPLE_RATE=1

# --- API produits (serveur et navigateur) ---
NUXT_DUMMY_JSON_BASE_URL=https://dummyjson.com
NUXT_PUBLIC_DUMMY_JSON_BASE_URL=https://dummyjson.com

# --- Secrets d'infrastructure ---
# Le docker-compose fournit des valeurs de développement par défaut, pour que
# `docker compose up` fonctionne sans configuration. Décommentez et remplacez
# ces lignes pour tout déploiement réel.
# GLITCHTIP_SECRET_KEY=            # openssl rand -hex 32
# GLITCHTIP_DB_PASSWORD=
# UMAMI_APP_SECRET=                # openssl rand -base64 32
# UMAMI_DB_PASSWORD=
